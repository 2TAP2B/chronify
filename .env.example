# Environment configuration for puku-timetracking
# Copy to .env and adjust values.

# Database
DATABASE_URL="postgresql://puku:puku@localhost:5432/puku?schema=public"

# NextAuth (trustHost: true — URL derived from request Host header, no NEXTAUTH_URL needed)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Auth.js debug logging (set to "true" to see detailed OAuth/OIDC error info)
AUTH_DEBUG=""

# SMTP
# For dev with Mailpit: SMTP_HOST=localhost SMTP_PORT=1025 SMTP_TLS=false SMTP_USER="" SMTP_PASS=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="chronify@example.com"
SMTP_TLS="true"

# Public Holidays (nager.date)
NAGER_DATE_API_URL="https://date.nager.at/api/v3"
NAGER_DATE_DEFAULT_REGION="DE"
NAGER_DATE_DEFAULT_STATE="NW"

# Push (VAPID) — generate with:
# npx web-push generate-vapid-keys
PUSH_VAPID_PUBLIC_KEY=""
PUSH_VAPID_PRIVATE_KEY=""
PUSH_VAPID_SUBJECT="mailto:admin@example.com"
NEXT_PUBLIC_PUSH_VAPID_PUBLIC_KEY=""

# App
APP_NAME="Chronify"
DEFAULT_LOCALE="de"
DEFAULT_TIMEZONE="Europe/Berlin"

# Domains (used by compose.yaml and middleware)
APP_DOMAIN="chronify.h0melab.cc"
KIOSK_DOMAIN="kiosk.chronify.h0melab.cc"

# CSRF (comma-separated origins allowed for mutation requests; empty = trust request host)
CSRF_ALLOWED_ORIGINS=""

# Backups (retention in days)
BACKUP_RETENTION_DAYS="14"

# OIDC (Pocket-ID)
OIDC_ISSUER="https://idp.sohn.uk"
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
NEXT_PUBLIC_OIDC_ENABLED=""
