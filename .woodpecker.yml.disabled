# DEACTIVATED — image builds now run via GitHub Actions
# (.github/workflows/docker.yml, image: ghcr.io/2tap2b/chronify).
# Kept as reference for how the image used to be built with Woodpecker on
# the self-hosted Forgejo instance (git.steltner.cloud). To re-enable:
# rename this file back to .woodpecker.yml and configure the
# forgejo_username / forgejo_token secrets in the Woodpecker project.
steps:
  - name: build-and-push
    image: woodpeckerci/plugin-docker-buildx
    privileged: true
    settings:
      repo: git.steltner.cloud/2tap2b/time-track-v3
      registry: git.steltner.cloud
      dockerfile: Dockerfile
      platforms: linux/amd64
      auto_tag: true
      username:
        from_secret: forgejo_username
      password:
        from_secret: forgejo_token
    when:
      - event: push
        branch: main
      - event: tag
        ref: refs/tags/v*
